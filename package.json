{
  "name": "lumo",
  "version": "44.0.2",
  "main": "src/main/main.js",
  "bin": {
    "lumo": "src/main/cli.js"
  },
  "scripts": {
    "start": "node scripts/start-lumo.js",
    "brand": "node scripts/brand-electron.js",
    "postinstall": "node scripts/brand-electron.js",
    "test": "node --test",
    "sync-upstream": "node scripts/sync-upstream.js",
    "dist": "electron-builder",
    "release": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "keywords": [],
  "author": "Oxeez",
  "license": "MIT",
  "description": "Lumo - audio player made for humans.",
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cfonts": "^3.3.1",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "hls.js": "^1.7.1",
    "tone": "^15.1.22"
  },
  "productName": "Lumo",
  "homepage": "https://github.com/Shadow671488/lumo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shadow671488/lumo.git"
  },
  "bugs": {
    "url": "https://github.com/Shadow671488/lumo/issues"
  },
  "build": {
    "appId": "com.lumo.player",
    "productName": "Lumo",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "vendor/**/*",
      "bin/**/*",
      "package.json",
      "!src/storage.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/01-default.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/01-default.png",
      "category": "AudioVideo"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Shadow671488",
        "repo": "lumo",
        "releaseType": "release"
      }
    ]
  }
}
